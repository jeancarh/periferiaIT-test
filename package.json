{
  "name": "periferia-oc-agent",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server.ts",
    "demo": "tsx demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "modulo": "tsx scripts/generar-modulo.ts"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
